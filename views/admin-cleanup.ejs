<div class="admin-head">
  <div>
    <a class="small faint link-underline" href="/admin/orders">← All orders</a>
    <h1 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-top:12px">Test orders</h1>
    <p class="small faint" style="margin-top:8px">
      Orders that look like they were placed by a test rather than a customer. Archiving hides an order from the
      lists, the figures and the exports without destroying it.
    </p>
  </div>
  <div class="row" style="gap:10px;flex-wrap:wrap">
    <span class="status-pill status-<%= stats.archived ? 'awaiting_payment' : 'paid' %>"><%= stats.archived %> archived</span>
    <span class="status-pill status-paid"><%= stats.total %> live</span>
  </div>
</div>

<% if (result === 'archived') { %>
  <div class="alert alert-success" style="margin-bottom:22px">Archived. <%= detail %></div>
<% } else if (result === 'restored') { %>
  <div class="alert alert-success" style="margin-bottom:22px">Restored. <%= detail %></div>
<% } else if (result === 'purged') { %>
  <div class="alert alert-success" style="margin-bottom:22px">Deleted permanently. <%= detail %></div>
<% } else if (result === 'purge-refused') { %>
  <div class="alert alert-warn" style="margin-bottom:22px"><%= detail %></div>
<% } else if (result === 'none') { %>
  <div class="alert alert-info" style="margin-bottom:22px">Nothing selected, so nothing changed. <%= detail %></div>
<% } %>

<div class="admin-card">
  <div class="row-between" style="margin-bottom:16px">
    <h3 style="margin:0">Looks like test data (<%= candidates.length %>)</h3>
  </div>

  <% if (!candidates.length) { %>
    <p class="muted small">Nothing in the order list matches a test signature.</p>
  <% } else { %>
    <form method="post" action="/admin/orders/archive">
      <table class="table">
        <thead>
          <tr>
            <th style="width:34px"></th>
            <th style="width:150px">Order</th>
            <th style="width:230px">Customer</th>
            <th style="width:150px">Placed</th>
            <th style="width:120px">Payment</th>
            <th class="num" style="width:100px">Total</th>
            <th style="min-width:280px">Why it matched</th>
          </tr>
        </thead>
        <tbody>
          <% candidates.forEach(o => { %>
            <tr>
              <td><input type="checkbox" name="ids" value="<%= o.id %>" checked /></td>
              <td class="mono tiny"><a class="link-underline" href="/admin/orders/<%= o.order_number %>"><%= o.order_number %></a></td>
              <td class="tiny"><%= o.customer_name %><div class="faint"><%= o.customer_email %></div></td>
              <td class="tiny faint nowrap"><%= o.created_at %></td>
              <td class="tiny"><span class="status-pill status-<%= o.payment_status %>"><%= o.payment_status.replace(/_/g, ' ') %></span></td>
              <td class="num tiny"><%= money(o.total_cents) %></td>
              <td class="tiny faint"><%= o.reasons.join(' · ') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <p class="tiny faint" style="margin:16px 0">
        An order carrying a gateway payment id is refused: that is a record with money behind it, and it has to be
        refunded or cancelled through its own page rather than hidden.
      </p>

      <div class="row" style="gap:12px;flex-wrap:wrap;align-items:center">
        <button class="btn btn-sm btn-solid" type="submit">Archive selected</button>
        <label class="tiny faint" style="display:flex;gap:8px;align-items:center">
          <input type="checkbox" name="allowPaid" value="1" />
          also archive orders that have a gateway payment id
        </label>
      </div>
    </form>
  <% } %>
</div>

<div class="admin-card">
  <div class="row-between" style="margin-bottom:16px">
    <h3 style="margin:0">Archived (<%= archived.length %>)</h3>
    <a class="btn btn-sm btn-ghost" href="/admin/orders?archived=only">See them in the order list</a>
  </div>

  <% if (!archived.length) { %>
    <p class="muted small">Nothing is archived.</p>
  <% } else { %>
    <form method="post" action="/admin/orders/unarchive" id="restore-form">
      <table class="table">
        <thead><tr><th style="width:34px"></th><th>Order</th><th>Customer</th><th>Archived</th><th class="num">Total</th></tr></thead>
        <tbody>
          <% archived.forEach(o => { %>
            <tr>
              <td><input type="checkbox" name="ids" value="<%= o.id %>" /></td>
              <td class="mono tiny"><a class="link-underline" href="/admin/orders/<%= o.order_number %>"><%= o.order_number %></a></td>
              <td class="tiny"><%= o.customer_name %><div class="faint"><%= o.customer_email %></div></td>
              <td class="tiny faint nowrap"><%= o.archived_at %></td>
              <td class="num tiny"><%= money(o.total_cents) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <button class="btn btn-sm" type="submit" style="margin-top:16px">Restore selected</button>
    </form>

    <hr class="rule" style="margin:26px 0" />

    <form method="post" action="/admin/orders/purge" onsubmit="return confirm('Permanently delete the selected archived orders? This cannot be undone.')">
      <h3 style="margin-bottom:10px">Delete permanently</h3>
      <p class="small" style="color:var(--warn);margin-bottom:14px">
        Deletes the order and its items, payment attempts and refunds. Only archived orders can be deleted, and this
        cannot be undone. Leave every box unticked to purge all archived orders.
      </p>
      <div class="row" style="gap:12px;flex-wrap:wrap;align-items:flex-end">
        <div class="field" style="min-width:200px">
          <label for="confirm">Type DELETE to confirm</label>
          <input class="input" type="text" id="confirm" name="confirm" placeholder="DELETE" autocomplete="off" />
        </div>
        <button class="btn btn-sm" type="submit" style="color:var(--danger);border-color:var(--danger)">Delete archived orders</button>
      </div>
      <p class="tiny faint" style="margin-top:12px">
        To delete specific ones, tick them above and submit this form instead — the two forms are separate so a
        mis-click cannot do both.
      </p>
    </form>
  <% } %>
</div>

<p class="tiny faint" style="margin-top:16px">
  Every archive, restore and purge is recorded in the <a class="link-underline" href="/admin/activity">activity log</a>
  with the account that did it.
</p>
