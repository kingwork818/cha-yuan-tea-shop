<div class="admin-head">
  <div>
    <span class="eyebrow">Operations</span>
    <h1 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-top:10px">Orders</h1>
    <p class="small faint" style="margin-top:8px">
      <%= total %> order<%= total === 1 ? '' : 's' %> match the filters below.
    </p>
  </div>
  <a class="btn btn-sm btn-ghost" href="/admin/orders.csv?<%= new URLSearchParams({ q: filters.q, status: filters.status, from: filters.from, to: filters.to }).toString() %>">Export as CSV</a>
</div>

<form method="get" action="/admin/orders" class="toolbar" style="align-items:flex-end;flex-wrap:wrap">
  <div class="field" style="min-width:220px">
    <label for="q">Search</label>
    <input class="input" type="search" id="q" name="q" value="<%= filters.q %>" placeholder="Order number, email, name, payment id" />
  </div>
  <div class="field" style="min-width:170px">
    <label for="status">Status</label>
    <select class="select" id="status" name="status">
      <option value="">All statuses</option>
      <% statuses.forEach(s => { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace(/_/g, ' ') %></option>
      <% }) %>
    </select>
  </div>
  <div class="field" style="min-width:150px">
    <label for="from">Placed from</label>
    <input class="input" type="date" id="from" name="from" value="<%= filters.from %>" />
  </div>
  <div class="field" style="min-width:150px">
    <label for="to">Placed to</label>
    <input class="input" type="date" id="to" name="to" value="<%= filters.to %>" />
  </div>
  <button class="btn btn-sm" type="submit">Filter</button>
  <% if (filters.q || filters.status || filters.from || filters.to) { %>
    <a class="btn btn-sm btn-ghost" href="/admin/orders">Reset</a>
  <% } %>
</form>

<div class="admin-card">
  <% if (!orders.length) { %>
    <p class="muted small">No orders match these filters.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Order</th><th>Customer</th><th>Ship to</th><th>Payment</th><th>Fulfilment</th>
          <th class="num">Total</th><th class="num">Refunded</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>
              <strong class="mono"><%= o.order_number %></strong>
              <div class="tiny faint"><%= o.created_at %></div>
            </td>
            <td>
              <%= o.customer_name %>
              <div class="tiny faint"><%= o.customer_email %></div>
            </td>
            <td class="tiny faint">
              <%= o.shipping_city %>, <%= o.shipping_province %><br /><%= o.shipping_country %>
            </td>
            <td>
              <span class="status-pill status-<%= o.payment_status %>"><%= o.payment_status.replace(/_/g, ' ') %></span>
              <% if (o.ott_cc_type) { %><div class="tiny faint" style="margin-top:5px"><%= o.ott_cc_type %> ····<%= o.ott_card_last4 %></div><% } %>
            </td>
            <td><span class="status-pill status-<%= o.status %>"><%= o.status.replace(/_/g, ' ') %></span></td>
            <td class="num"><%= money(o.total_cents) %></td>
            <td class="num"><%= o.refunded_cents ? money(o.refunded_cents) : '—' %></td>
            <td><a class="link-underline small" href="/admin/orders/<%= o.order_number %>">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<p class="tiny faint" style="margin-top:16px">
  Dates filter on when the order was placed. The CSV export contains every column needed for reconciliation,
  including the gateway reference and payment id for each order.
</p>
