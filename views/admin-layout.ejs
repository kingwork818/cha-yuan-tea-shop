<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' && title ? title : 'Admin' %> — <%= store.name %></title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <link rel="icon" href="<%= asset('/favicon.svg') %>" type="image/svg+xml" />
  <link rel="stylesheet" href="/fonts/cormorant.css" />
  <link rel="stylesheet" href="/fonts/inter.css" />
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
</head>
<body class="admin-body">
  <% if (typeof admin === 'undefined' || !admin) { %>
    <%- body %>
  <% } else { %>
    <%
      /*
       * The role decides what the page offers, but never what it allows: every
       * write endpoint checks the session on the server too. A reviewer sees no
       * buttons to press and would be refused if they guessed a URL.
       */
      const isReviewer = admin.role === 'reviewer';
    %>
    <div class="admin-shell">
      <aside class="admin-side">
        <a class="brand" href="/admin">
          <img src="/img/logo-mark.svg" alt="" style="height:40px" />
          <span class="brand-text">
            <span class="brand-name" style="font-size:1.1rem"><%= store.name %></span>
            <span class="brand-sub">Back office</span>
          </span>
        </a>

        <nav class="admin-nav" aria-label="Admin">
          <a href="/admin" class="<%= view === 'admin-dashboard' ? 'is-active' : '' %>">Dashboard</a>
          <a href="/admin/orders" class="<%= view === 'admin-orders' || view === 'admin-order' ? 'is-active' : '' %>">Orders</a>
          <a href="/admin/orders/cleanup" class="<%= view === 'admin-cleanup' ? 'is-active' : '' %>" style="padding-left:26px;font-size:0.78rem">Test orders</a>
          <a href="/admin/products" class="<%= view === 'admin-products' ? 'is-active' : '' %>">Catalogue</a>
          <a href="/admin/webhooks" class="<%= view === 'admin-webhooks' ? 'is-active' : '' %>">Payment callbacks</a>
          <a href="/admin/emails" class="<%= view === 'admin-emails' ? 'is-active' : '' %>">Email</a>
          <a href="/admin/activity" class="<%= view === 'admin-activity' ? 'is-active' : '' %>">Activity log</a>
          <a href="/admin/settings" class="<%= view === 'admin-settings' ? 'is-active' : '' %>">Settings</a>
        </nav>

        <div style="margin-top:26px;padding-top:22px;border-top:1px solid var(--line-soft)">
          <p class="tiny faint" style="margin-bottom:6px">Signed in as</p>
          <p class="small" style="word-break:break-all"><%= admin.email %></p>
          <p class="tiny" style="margin-top:8px">
            <% if (isReviewer) { %>
              <span class="status-pill status-awaiting_payment">Read-only access</span>
            <% } else { %>
              <span class="status-pill status-paid">Owner</span>
            <% } %>
          </p>
          <form method="post" action="/admin/logout" style="margin-top:14px">
            <button class="btn btn-sm btn-ghost btn-block" type="submit">Sign out</button>
          </form>
          <a class="btn btn-sm btn-ghost btn-block" href="/" style="margin-top:8px">View storefront</a>
        </div>

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--line-soft)">
          <p class="tiny faint">Card payments</p>
          <p class="mono small gold"><%= payment.mode === 'mock' ? 'Test mode' : 'Live' %></p>
        </div>
      </aside>

      <main class="admin-main">
        <% if (isReviewer) { %>
          <div class="alert alert-info" style="margin-bottom:22px">
            <strong>Read-only review access.</strong> Every page is visible; refunds, order status changes and
            stock edits are disabled for this account, and anything attempted is recorded in the
            <a class="link-underline" href="/admin/activity">activity log</a>.
          </div>
        <% } %>
        <%- body %>
      </main>
    </div>
  <% } %>

  <script src="/js/app.js" defer></script>
</body>
</html>
