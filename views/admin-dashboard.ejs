<div class="admin-head">
  <div>
    <span class="eyebrow">Overview</span>
    <h1 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-top:10px">Dashboard</h1>
    <p class="small faint" style="margin-top:8px">
      Orders, money and messages for <%= store.name %>.
    </p>
  </div>
  <div class="row" style="gap:10px;flex-wrap:wrap">
    <a class="btn btn-sm btn-ghost" href="/admin/orders.csv">Export orders (CSV)</a>
    <a class="btn btn-sm btn-ghost" href="/admin/orders">All orders</a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat">
    <div class="k">Revenue (paid)</div>
    <div class="v"><%= money(stats.revenue) %></div>
    <div class="sub"><%= stats.paid %> paid orders</div>
  </div>
  <div class="stat">
    <div class="k">Orders</div>
    <div class="v"><%= stats.total %></div>
    <div class="sub"><%= stats.units %> items sold</div>
  </div>
  <div class="stat">
    <div class="k">Awaiting payment</div>
    <div class="v"><%= stats.awaiting %></div>
    <div class="sub">not yet confirmed by the gateway</div>
  </div>
  <div class="stat">
    <div class="k">Refunds</div>
    <div class="v"><%= auditSummary.refunds %></div>
    <div class="sub"><%= stats.refunded %> orders refunded in full</div>
  </div>
</div>

<div class="grid grid-2" style="align-items:start;gap:24px">
  <div class="admin-card">
    <div class="row-between" style="margin-bottom:16px">
      <h3 style="margin:0">Operating checks</h3>
    </div>
    <table class="table">
      <tbody>
        <tr>
          <td>Card payments</td>
          <td>
            <% if (payment.mode === 'mock') { %>
              <span class="status-pill status-awaiting_payment">Test mode</span>
            <% } else { %>
              <span class="status-pill status-paid">Live</span>
            <% } %>
          </td>
        </tr>
        <tr>
          <td>Gateway callbacks</td>
          <td>
            <% if (stats.pendingWebhooks === 0) { %>
              <span class="status-pill status-paid">All processed</span>
            <% } else { %>
              <span class="status-pill status-awaiting_payment"><%= stats.pendingWebhooks %> unprocessed</span>
            <% } %>
          </td>
        </tr>
        <tr>
          <td>Order receipts</td>
          <td>
            <% if (!mailEnabled) { %>
              <span class="status-pill status-awaiting_payment">Not configured</span>
            <% } else if (mailSummary.failed) { %>
              <span class="status-pill status-failed"><%= mailSummary.failed %> failed</span>
            <% } else { %>
              <span class="status-pill status-paid"><%= mailSummary.week %> sent this week</span>
            <% } %>
          </td>
        </tr>
        <tr>
          <td>Currency and tax</td>
          <td class="mono small"><%= store.currency %> · <%= store.taxLabel %></td>
        </tr>
        <tr>
          <td>Dispatch promise</td>
          <td class="small">Within 48 hours, from the warehouse in China</td>
        </tr>
      </tbody>
    </table>
    <p class="tiny faint" style="margin-top:14px">
      Details of the payment integration and the shop's own settings are on
      <a class="link-underline" href="/admin/settings">Settings</a>.
    </p>
  </div>

  <div class="admin-card">
    <div class="row-between" style="margin-bottom:16px">
      <h3 style="margin:0">Recent staff activity</h3>
      <a class="btn btn-sm btn-ghost" href="/admin/activity">Full log</a>
    </div>
    <% if (!activity.length) { %>
      <p class="muted small">Nothing recorded yet. Sign-ins, refunds and status changes appear here.</p>
    <% } else { %>
      <table class="table">
        <thead><tr><th>When</th><th>Who</th><th>Action</th></tr></thead>
        <tbody>
          <% activity.forEach(a => { %>
            <tr>
              <td class="tiny faint nowrap"><%= a.created_at %></td>
              <td class="tiny"><%= a.actor %><div class="tiny faint"><%= a.role %></div></td>
              <td class="tiny"><span class="mono"><%= a.action %></span><% if (a.target) { %> <span class="faint"><%= a.target %></span><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<div class="admin-card">
  <div class="row-between" style="margin-bottom:18px">
    <h3 style="margin:0">Recent orders</h3>
    <a class="btn btn-sm btn-ghost" href="/admin/orders">All orders</a>
  </div>

  <% if (!recent.length) { %>
    <p class="muted small">No orders yet.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Order</th><th>Customer</th><th>Placed</th><th>Payment</th><th class="num">Total</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(o => { %>
          <tr>
            <td><strong class="mono"><%= o.order_number %></strong></td>
            <td><%= o.customer_name %><br /><span class="tiny faint"><%= o.customer_email %></span></td>
            <td class="tiny faint nowrap"><%= o.created_at %></td>
            <td><span class="status-pill status-<%= o.payment_status %>"><%= o.payment_status.replace(/_/g, ' ') %></span></td>
            <td class="num"><%= money(o.total_cents) %></td>
            <td><a class="link-underline small" href="/admin/orders/<%= o.order_number %>">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="admin-card">
  <div class="row-between" style="margin-bottom:18px">
    <h3 style="margin:0">Low stock</h3>
    <a class="btn btn-sm btn-ghost" href="/admin/products">Manage catalogue</a>
  </div>
  <% if (!lowStock.length) { %>
    <p class="muted small">Everything is comfortably in stock.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Product</th><th>Size</th><th class="num">Stock</th><th></th></tr></thead>
      <tbody>
        <% lowStock.forEach(v => { %>
          <tr>
            <td><%= v.name %></td>
            <td class="tiny faint"><%= v.label %></td>
            <td class="num" style="<%= v.stock === 0 ? 'color:var(--danger)' : v.stock <= 3 ? 'color:var(--warn)' : '' %>"><%= v.stock %></td>
            <td><a class="link-underline small" href="/tea/<%= v.slug %>">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
