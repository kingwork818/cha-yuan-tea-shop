<div class="admin-head">
  <div>
    <span class="eyebrow">Read-only</span>
    <h1 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-top:10px">That action is not available</h1>
  </div>
</div>

<div class="admin-card">
  <p class="small">
    You are signed in with read-only access, so nothing was changed. The attempt was recorded in the
    <a class="link-underline" href="/admin/activity">activity log</a>.
  </p>
  <p class="small faint" style="margin-top:14px">
    Requested: <span class="mono"><%= action %></span>
  </p>
  <div class="row" style="gap:10px;margin-top:20px;flex-wrap:wrap">
    <a class="btn btn-sm btn-solid" href="/admin">Back to the dashboard</a>
    <a class="btn btn-sm btn-ghost" href="/admin/orders">Orders</a>
  </div>
</div>
