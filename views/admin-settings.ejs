<div class="admin-head">
  <div>
    <span class="eyebrow">Configuration</span>
    <h1 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-top:10px">Settings</h1>
    <p class="small faint" style="margin-top:8px">
      The configuration this deployment is running with, as the application itself sees it.
    </p>
  </div>
  <div class="row" style="gap:10px;flex-wrap:wrap">
    <% if (!problems.length) { %>
      <span class="status-pill status-paid">No blocking problems</span>
    <% } else { %>
      <span class="status-pill status-failed"><%= problems.length %> problem(s)</span>
    <% } %>
  </div>
</div>

<% if (problems.length || warnings.length) { %>
  <div class="admin-card">
    <h3>Checks</h3>
    <% if (problems.length) { %>
      <p class="small" style="margin-bottom:10px"><strong style="color:var(--danger)">Blocking</strong></p>
      <ul class="small" style="margin:0 0 18px 18px;list-style:disc">
        <% problems.forEach(p => { %><li style="margin-bottom:8px"><%= p %></li><% }) %>
      </ul>
    <% } %>
    <% if (warnings.length) { %>
      <p class="small" style="margin-bottom:10px"><strong>Worth noting</strong></p>
      <ul class="small" style="margin:0 0 0 18px;list-style:disc">
        <% warnings.forEach(w => { %><li style="margin-bottom:8px"><%= w %></li><% }) %>
      </ul>
    <% } %>
  </div>
<% } %>

<div class="grid grid-2" style="align-items:start;gap:24px">
  <div class="admin-card">
    <h3>Trading entity</h3>
    <table class="table">
      <tbody>
        <tr><td>Registered name</td><td><%= company.legalName %></td></tr>
        <tr><td>Trading as</td><td><%= company.tradingName %></td></tr>
        <tr><td>Registered address</td><td><%= company.addressLines.join(', ') %></td></tr>
        <tr><td>Country</td><td><%= company.country %></td></tr>
        <tr><td>Company registration</td><td class="mono"><%= company.missing.registrationNumber ? 'To be supplied' : company.registrationNumber %></td></tr>
        <tr><td>Tax registration</td><td class="mono"><%= company.missing.taxNumber ? 'To be supplied' : company.taxNumber %></td></tr>
        <tr><td>Support email</td><td class="mono tiny"><%= company.email %></td></tr>
        <tr><td>Privacy email</td><td class="mono tiny"><%= company.privacyEmail %></td></tr>
        <tr><td>Telephone</td><td class="mono tiny"><%= company.phone %></td></tr>
        <tr><td>Returns address</td><td class="tiny"><%= company.hasReturnsAddress ? company.returnsAddressLines.join(', ') : 'Not set' %></td></tr>
      </tbody>
    </table>
  </div>

  <div class="admin-card">
    <h3>Storefront</h3>
    <table class="table">
      <tbody>
        <tr><td>Store name</td><td><%= store.name %></td></tr>
        <tr><td>Tagline</td><td class="small"><%= store.tagline %></td></tr>
        <tr><td>Public URL</td><td class="mono tiny" style="word-break:break-all"><%= store.publicBaseUrl %></td></tr>
        <tr><td>Currency</td><td class="mono"><%= store.currency %></td></tr>
        <tr><td>Tax</td><td class="mono"><%= store.taxLabel %></td></tr>
        <tr><td>Free shipping over</td><td class="mono"><%= money(store.freeShippingThreshold) %></td></tr>
        <tr><td>Flat shipping</td><td class="mono"><%= money(store.flatShippingFee) %></td></tr>
        <tr><td>Ships from</td><td>China · dispatched within 48 hours</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="admin-card">
  <h3>Card payments</h3>
  <table class="table">
    <tbody>
      <tr>
        <td>Mode</td>
        <td>
          <% if (payment.mode === 'mock') { %>
            <span class="status-pill status-awaiting_payment">Test mode</span>
          <% } else { %>
            <span class="status-pill status-paid"><%= payment.mode %></span>
          <% } %>
        </td>
      </tr>
      <tr><td>Gateway endpoint</td><td class="mono tiny"><%= config.payment.baseUrl %></td></tr>
      <tr><td>Merchant id</td><td class="mono tiny"><%= config.payment.merchantId || '—' %></td></tr>
      <tr><td>Application credentials</td>
        <td class="small">
          <% const parts = [config.payment.appId ? 'app id' : '', config.payment.appKey ? 'app key' : '', config.payment.signKey ? 'signing key' : ''].filter(Boolean); %>
          <% if (payment.mode === 'mock') { %>
            Not applicable in test mode
          <% } else { %>
            <%= parts.length ? parts.join(' · ') + ' configured' : 'not configured' %>
          <% } %>
        </td>
      </tr>
      <tr><td>Callback URL</td><td class="mono tiny" style="word-break:break-all"><%= store.publicBaseUrl %>/api/ottpay/callback</td></tr>
      <tr><td>3-D Secure</td><td class="small">3-D Secure 2 challenge flow supported</td></tr>
      <tr><td>Cards accepted</td><td class="small">Visa · Mastercard · American Express · Discover · JCB · Diners Club · UnionPay</td></tr>
      <tr><td>Card data</td><td class="small">Never stored. Only the card type and the last four digits are kept, on the order.</td></tr>
    </tbody>
  </table>
</div>

<div class="admin-card">
  <h3>Email</h3>
  <table class="table">
    <tbody>
      <tr><td>Status</td><td><%= mailEnabled ? 'Configured' : 'Not configured' %></td></tr>
      <tr><td>Sends as</td><td class="mono tiny"><%= config.mail.from %></td></tr>
      <tr><td>Replies go to</td><td class="mono tiny"><%= config.mail.replyTo %></td></tr>
      <tr><td>Receipts sent on payment</td><td class="small"><%= mailEnabled ? 'yes' : 'no — and the storefront does not claim otherwise' %></td></tr>
      <tr><td>Log</td><td><a class="link-underline small" href="/admin/emails">Open the email log</a></td></tr>
    </tbody>
  </table>
</div>

<p class="tiny faint" style="margin-top:16px">
  These values come from the deployment's environment, not from this page. Changing them is the owner's job in the
  hosting dashboard, and deliberately not a web form: a page that could rename the trading entity or point the payment
  gateway somewhere else is a way to break a live shop from a browser.
</p>
