<div class="admin-head">
  <div>
    <span class="eyebrow">Diagnostics</span>
    <h1 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-top:10px">Email</h1>
    <p class="small faint" style="margin-top:8px">
      Every message the shop has tried to send, with what happened to it.
    </p>
  </div>
  <div class="row" style="gap:10px;flex-wrap:wrap">
    <% if (mailEnabled) { %>
      <span class="status-pill status-paid">Configured</span>
    <% } else { %>
      <span class="status-pill status-awaiting_payment">Not configured</span>
    <% } %>
  </div>
</div>

<% if (typeof req !== 'undefined' && req.query.test === 'ok') { %>
  <div class="alert alert-success" style="margin-bottom:22px">Test message accepted by the mail provider.</div>
<% } %>
<% if (typeof req !== 'undefined' && req.query.test === 'failed') { %>
  <div class="alert alert-error" style="margin-bottom:22px">The mail provider rejected the test message. The reason is in the log below.</div>
<% } %>
<% if (typeof req !== 'undefined' && req.query.test === 'skipped') { %>
  <div class="alert alert-warn" style="margin-bottom:22px">Nothing was sent: outgoing mail is not configured on this deployment.</div>
<% } %>

<div class="grid grid-2" style="align-items:start;gap:24px">
  <div class="admin-card">
    <h3>Outgoing mail</h3>
    <table class="table">
      <tbody>
        <tr><td>Status</td><td><%= mailEnabled ? 'Configured' : 'Not configured' %></td></tr>
        <tr><td>Sends as</td><td class="mono tiny"><%= mailFrom %></td></tr>
        <tr><td>Sent (all time)</td><td class="num"><%= summary.sent %></td></tr>
        <tr><td>Sent (last 7 days)</td><td class="num"><%= summary.week %></td></tr>
        <tr><td>Failed</td><td class="num"><%= summary.failed %></td></tr>
        <tr><td>Skipped</td><td class="num"><%= summary.skipped %></td></tr>
      </tbody>
    </table>
    <% if (!mailEnabled) { %>
      <p class="tiny faint" style="margin-top:14px">
        Missing settings: <span class="mono"><%= mailReason %></span>. Until those are set, the storefront does not
        promise a receipt by email, and nothing is queued.
      </p>
    <% } %>
  </div>

  <div class="admin-card">
    <h3>Send a test message</h3>
    <p class="small muted" style="margin-bottom:16px">
      Sends a sample order receipt so delivery can be confirmed without placing a real order.
    </p>
    <% if (!mailEnabled) { %>
      <p class="small" style="color:var(--warn)">Configure outgoing mail before testing.</p>
    <% } else if (!canWrite) { %>
      <p class="small muted">Read-only access: the owner can send a test message.</p>
    <% } else { %>
      <form method="post" action="/admin/emails/test" class="stack-16">
        <div class="field">
          <label for="to">Send to</label>
          <input class="input" type="email" id="to" name="to" value="<%= admin.email %>" required />
        </div>
        <button class="btn btn-sm btn-solid btn-block" type="submit">Send test receipt</button>
      </form>
    <% } %>
  </div>
</div>

<div class="admin-card">
  <h3>Log</h3>
  <% if (!emails.length) { %>
    <p class="muted small">Nothing has been sent yet.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>When</th><th>Kind</th><th>To</th><th>Subject</th><th>Order</th><th>Status</th></tr></thead>
      <tbody>
        <% emails.forEach(m => { %>
          <tr>
            <td class="tiny faint nowrap"><%= m.created_at %></td>
            <td class="tiny mono"><%= m.kind %></td>
            <td class="tiny"><%= m.recipient %></td>
            <td class="tiny"><%= m.subject %></td>
            <td class="tiny mono"><%= m.order_number || '—' %></td>
            <td>
              <span class="status-pill status-<%= m.status === 'sent' ? 'paid' : m.status === 'failed' ? 'failed' : 'awaiting_payment' %>"><%= m.status %></span>
              <% if (m.error) { %><div class="tiny" style="color:var(--danger)"><%= m.error %></div><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
